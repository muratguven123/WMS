<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.wms</groupId>
    <artifactId>wms-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>WMS Microservices Parent</name>
    <description>Parent POM for WMS Microservices System</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <properties>
        <java.version>21</java.version>
        <spring-boot.version>3.2.5</spring-boot.version>
        <!-- Spring Boot 3.2.x uyumlu springdoc (2.8.x Spring Framework 6.2+ gerektirir) -->
        <springdoc.version>2.5.0</springdoc.version>
        <!-- mvn spring-boot:run -pl ${service.module} -->
        <service.module>wms-core-service</service.module>
        <!--
            JaCoCo kapsam kapısı taban eşikleri (BUNDLE, coveredratio).
            Güvenli başlangıç: en zayıf modül (wms-integration-service: talimat %21.5, satır %26)
            dahil TÜM modüller bunu hâlihazırda geçiyor; amaç kapsamın daha aşağı DÜŞMESİNİ önlemek.
            Bir modül daha yükseğe ulaştıkça kendi pom'unda bu property'leri artırarak ratchet uygulayın.
        -->
        <jacoco.min.instruction>0.20</jacoco.min.instruction>
        <jacoco.min.line>0.20</jacoco.min.line>
    </properties>

    <modules>
        <module>wms-test-support</module>
        <module>wms-common-events</module>
        <module>wms-core-service</module>
        <module>wms-localization-service</module>
        <module>wms-finance-service</module>
        <module>wms-billing-service</module>
        <module>wms-integration-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- *IT sınıflarını mvn verify aşamasında koşturur (Testcontainers/Docker gerektirir) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- JaCoCo IT ajanını (prepare-agent-integration) IT JVM'ine bağlar;
                         @{...} geç değerlendirme prepare-agent-integration çalıştıktan sonra çözülür. -->
                    <argLine>@{failsafeArgLine}</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                JaCoCo — test kapsamı ölçümü ve kapsam kapısı (ratchet).
                * Unit (surefire) VE IT (failsafe) kapsamı aynı jacoco.exec dosyasına append edilir,
                  böylece rapor gerçek birleşik kapsamı gösterir (repository/migration IT'leri dahil).
                * 'check' her modülde BUNDLE seviyesinde minimum talimat + satır oranını zorlar.
                  Eşikler property (jacoco.min.*) ile yönetilir; bir modül daha yüksek bir taban
                  tutturduğunda kendi pom'unda property'yi yükselterek ratchet uygulanabilir.
                * Başlangıç eşiği güvenli (tüm modüller hâlihazırda geçiyor); amaç kapsamın
                  bir daha DÜŞMESİNİ engellemek. Sürüm Spring Boot BOM tarafından yönetilir.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <!-- IT kapsamını da aynı exec'e ekle (append), tek birleşik rapor için. -->
                            <destFile>${project.build.directory}/jacoco.exec</destFile>
                            <propertyName>failsafeArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.min.instruction}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.min.line}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>ops</id>
            <modules>
                <module>wms-inbound-service</module>
                <module>wms-inventory-service</module>
                <module>wms-outbound-service</module>
                <module>wms-notification-service</module>
            </modules>
        </profile>
        <profile>
            <id>spring-boot-modules</id>
            <activation>
                <file>
                    <exists>${basedir}/src/main/java</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
